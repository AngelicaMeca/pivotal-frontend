/* Hoja de estilo del sitio Pivotal.
   GENERADA por pipeline/site_build.py desde site/templates/pivotal.css.j2 + site/theme.yaml.
   No editar a mano: se pisa en el proximo `make site`. Para re-brandear, se edita theme.yaml.

   Lenguaje visual: el del SITIO INSTITUCIONAL (decision de Francisco, 22-sep-2026), que
   deroga el cromo verde del 10-ago. Lo que lo define:
     1. Lienzo CREMA y cromo COCOA (cabecera, menu lateral, banda de breadcrumb), con la
        crema como color de texto sobre el cocoa.
     2. Paneles en cajas de crema aclarada, borde fino y esquinas redondeadas, planas: sin
        sombras ni degradados, como las tarjetas del sitio.
     3. Rotulos chicos en monoespaciada versalita y titulos en la serif de la marca.
     4. Densidad: alturas de grafico chicas, padding corto, nada de aire decorativo. El
        tablero sigue entrando en una pantalla.
   Los colores de DATOS (rampas, series) no cambian con el tema: los manda el protocolo. */

:root {
  --primario: {{ c.primario }};
  --primario-medio: {{ c.primario_medio }};
  --secundario: {{ c.secundario }};
  --fondo: {{ c.fondo }};
  --texto: {{ c.texto }};
  --texto-apoyo: {{ c.texto_apoyo }};
  --borde: {{ c.borde }};
  --fondo-cuadro: {{ c.fondo_cuadro }};
  --fondo-apoyo: {{ c.fondo_apoyo }};
  --cromo: {{ c.cromo }};
  --cromo-oscuro: {{ c.cromo_oscuro }};
  --seleccion: {{ c.seleccion }};
  --borde-panel: {{ c.borde_panel }};
  --sobre-cromo: {{ c.sobre_cromo }};
  --sobre-seleccion: {{ c.sobre_seleccion }};
  --enlace: {{ c.enlace }};
  --positivo: {{ variacion.positivo }};
  --negativo: {{ variacion.negativo }};
  --neutro: {{ variacion.cero }};
  --sin-dato: {{ sin_dato }};
  --rotulos: {{ theme.tipografia.familia_rotulos }};
  --titulos: {{ theme.tipografia.familia_titulos }};
  /* Esquinas del sitio: cajas redondeadas, controles en pildora */
  --radio: 16px;
  --radio-chico: 8px;
  --radio-pildora: 999px;
  /* Fila marcada de una tabla: el rosa de seleccion, apenas insinuado sobre la caja */
  --resaltado: color-mix(in srgb, {{ c.seleccion }} 22%, {{ c.fondo_cuadro }});
}

* { box-sizing: border-box; }

html { -webkit-text-size-adjust: 100%; }

body {
  margin: 0;
  background: var(--fondo);
  color: var(--texto);
  font-family: {{ theme.tipografia.familia }};
  font-size: {{ theme.tipografia.base_px }}px;
  line-height: 1.45;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* Rotulo chico: se usa en pies, escalas y toggles. */
.rotulo {
  font-family: var(--rotulos); font-size: .68rem; text-transform: uppercase;
  letter-spacing: .12em; color: var(--texto-apoyo);
}

/* ---------- cabecera ----------
   Una sola franja COCOA de lado a lado: el logo provincial a la izquierda y, a la derecha,
   los botones que declara la seccion en site/navegacion.yaml y las banderas de idioma.

   El bloque del logo era claro (Facu, 10-ago) porque el PNG de la provincia esta armado
   para fondo claro. Desde el 22-sep-2026 la cabecera es marron entera (Francisco): el logo
   usa la variante negativa del isologotipo (theme.yaml, logo_provincia) y ya no necesita su
   propio recuadro. TODO lo que va sobre la cabecera se escribe en --sobre-cromo. */
.cabecera {
  display: flex; align-items: stretch;
  background: var(--cromo); color: var(--sobre-cromo);
}
/* PUESTA del logo (cuarta tanda, logo_provincial_bien_puesto: "esta mal puesto... se ve
   horrible"): el bloque mide lo que mide el logo (sin la plancha vacia del min-width que
   habia antes), el isologotipo va GRANDE como en el mockup (la cabecera del mockup es alta:
   el logo manda su alto) y centrado sobre la leyenda de gobierno. Sin deformar ni recortar:
   alto fijo y ancho auto del PNG. El asset es el mismo (backlog 41). */
.cabecera-logo {
  flex: 0 0 auto; display: flex; align-items: center;
  padding: .55rem 1.3rem .55rem 1.1rem;
}
.logo-con-imagen {
  text-decoration: none; display: flex; flex-direction: column; align-items: center;
}
.logo-imagen { height: 3.8rem; width: auto; display: block; }
.logo-con-imagen .logo-bajada { margin-top: .3rem; text-align: center; font-size: .62rem; }
/* Wordmark sobrio de texto: fallback cuando el cliente no trae asset de logo (F3). */
.logo-wordmark { text-decoration: none; display: block; }
.logo-nombre {
  display: block; color: var(--sobre-cromo); font-weight: 800; font-size: 1.45rem;
  letter-spacing: -.01em; line-height: 1.1; text-transform: uppercase;
}
/* La leyenda de gobierno va sobre el cocoa como el resto de la cabecera. */
.logo-bajada { display: block; font-size: .66rem; color: var(--sobre-cromo); margin-top: .1rem; }
.cabecera-franja {
  flex: 1 1 auto; min-width: 0;
  display: flex; align-items: center; gap: 1rem; padding: .5rem 1rem;
}
.boton-cabecera {
  font: inherit; font-size: .84rem; font-weight: 650; color: var(--sobre-cromo);
  background: transparent; border: 1px solid var(--sobre-cromo);
  border-radius: var(--radio-pildora);
  padding: .3rem .7rem; flex: 0 0 auto;
}
.boton-cabecera[disabled] { cursor: not-allowed; opacity: .75; }
/* Botones de cabecera HABILITADOS (10-ago, segunda tanda): son links de verdad hacia el area
   territorial y la comparacion NOA. Solo los dibujan las secciones que los declaran en
   site/navegacion.yaml (`botones_cabecera`); el resto sigue con el boton deshabilitado. */
a.boton-cabecera { text-decoration: none; display: inline-block; }
a.boton-cabecera:hover { background: color-mix(in srgb, var(--sobre-cromo) 16%, transparent); }
.prox {
  font-family: var(--rotulos); font-size: .52rem; text-transform: uppercase;
  letter-spacing: .08em; border: 1px solid currentColor; border-radius: var(--radio-chico);
  padding: .05rem .25rem; opacity: .85; vertical-align: 2px;
}
/* Banderas de idioma es/en/pt, arriba a la derecha, donde estaba el titulo duplicado
   (tercera tanda del 10-ago: "ahí iban las banderas de idiomas"; backlog 33). Español
   activa; ingles y portugues deshabilitadas con "Próximamente" (tooltip): excepcion
   acotada a la regla de botones muertos. */
.cabecera-banderas { margin-left: auto; display: flex; align-items: center; gap: .5rem; }
/* Siglas ES / EN / PT: a este tamaño tres banderitas no se distinguen, y el rotulo chico en
   monoespaciada versalita es como escribe estas cosas el sitio. */
.cabecera-banderas .bandera {
  display: inline-flex; border-radius: var(--radio-pildora);
  font-family: var(--rotulos); font-size: .62rem; letter-spacing: .1em;
  padding: .12rem .4rem; border: 1px solid color-mix(in srgb, var(--sobre-cromo) 45%, transparent);
}
.cabecera-banderas .bandera.activa {
  background: var(--sobre-cromo); color: var(--cromo); border-color: var(--sobre-cromo);
  font-weight: 600;
}
.cabecera-banderas .bandera.deshabilitada { opacity: .6; cursor: not-allowed; }
/* Texto solo para lectores de pantalla (el nombre completo del idioma). */
.sr-solo {
  position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden;
  clip-path: inset(50%); white-space: nowrap; border: 0;
}

.cabecera-titulo { margin-left: auto; text-align: right; min-width: 0; }
.cabecera-titulo h1 {
  margin: 0; font-family: var(--titulos); font-size: 1.15rem; font-weight: 400;
  letter-spacing: -.005em; color: var(--sobre-cromo);
}
.cabecera-titulo p {
  margin: .05rem 0 0; font-size: .74rem; color: color-mix(in srgb, var(--sobre-cromo) 75%, transparent);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.marca-estado {
  font-family: var(--rotulos); font-size: .6rem; text-transform: uppercase;
  letter-spacing: .12em; border: 1px solid color-mix(in srgb, var(--sobre-cromo) 60%, transparent); border-radius: var(--radio-chico);
  padding: .1rem .35rem; color: color-mix(in srgb, var(--sobre-cromo) 90%, transparent); flex: 0 0 auto;
}

/* ---------- marco: menu lateral verde + contenido ---------- */
.marco { display: flex; align-items: stretch; flex: 1 1 auto; min-height: 0; }
.menu-lateral {
  flex: 0 0 10.5rem; background: var(--cromo); color: var(--sobre-cromo); padding: .8rem .6rem 1.2rem;
}
.menu-inicio {
  display: block; text-align: center; border: 1px solid var(--sobre-cromo);
  border-radius: var(--radio-pildora);
  color: var(--sobre-cromo); font-weight: 700; font-size: .95rem; padding: .25rem .4rem;
  text-decoration: none; margin: 0 .15rem .9rem;
}
.menu-inicio:hover { background: color-mix(in srgb, var(--sobre-cromo) 14%, transparent); }
.menu-sector { margin: 0 0 .15rem; }
.menu-sector summary {
  list-style: none; cursor: pointer; display: flex; align-items: center;
  justify-content: space-between; gap: .4rem; color: var(--sobre-cromo); font-weight: 650;
  font-size: .9rem; padding: .3rem .35rem; border-radius: var(--radio-chico);
}
.menu-sector summary::-webkit-details-marker { display: none; }
.menu-sector summary::after { content: "▾"; font-size: .7rem; opacity: .9; }
.menu-sector[open] summary::after { content: "▴"; }
.menu-sector summary:hover { background: color-mix(in srgb, var(--sobre-cromo) 14%, transparent); }
.menu-sector ul { list-style: none; margin: 0 0 .3rem; padding: 0 0 0 .5rem; }
.menu-sector li a {
  display: block; color: color-mix(in srgb, var(--sobre-cromo) 92%, transparent); text-decoration: none; font-size: .8rem;
  padding: .18rem .35rem; border-radius: var(--radio-chico);
}
.menu-sector li a:hover { background: color-mix(in srgb, var(--sobre-cromo) 14%, transparent); }
.menu-sector li a[aria-current] { background: var(--cromo-oscuro); font-weight: 650; }
.menu-prox {
  margin: 0 0 .3rem; padding-left: .85rem; font-family: var(--rotulos); font-size: .58rem;
  text-transform: uppercase; letter-spacing: .1em; color: color-mix(in srgb, var(--sobre-cromo) 75%, transparent);
}

.contenido { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; }

/* ---------- banda verde: breadcrumb + selector de periodo ----------
   La ruta jerarquica a la izquierda (cada nivel linkea a SU nivel) y el selector de campaña
   como tira de pestañitas a la derecha, como en la captura. */
.banda {
  background: var(--cromo); color: var(--sobre-cromo); display: flex; align-items: center;
  gap: .9rem; padding: .28rem .8rem; flex-wrap: wrap;
}
.miga { flex: 1 1 auto; min-width: 0; font-size: .92rem; }
.miga a { color: color-mix(in srgb, var(--sobre-cromo) 92%, transparent); text-decoration: none; }
.miga a:hover { text-decoration: underline; color: var(--sobre-cromo); }
.miga span[aria-current], .miga .miga-actual { color: var(--sobre-cromo); font-weight: 700; }
.miga-sep { color: color-mix(in srgb, var(--sobre-cromo) 75%, transparent); }
.banda-titulo { flex: 1 1 auto; font-weight: 700; font-size: .95rem; }

/* Selector de periodo: rotulo obligatorio ("Campaña") en caja blanca + tira de pestañitas
   sobre verde oscuro; la activa se enciende en blanco. */
.periodo { display: flex; align-items: center; gap: .4rem; flex: 0 0 auto; }
.periodo-rotulo {
  background: var(--fondo-cuadro); color: var(--texto); font-weight: 650; font-size: .8rem;
  padding: .16rem .5rem; border-radius: var(--radio-chico);
}
.periodo-tira {
  display: flex; gap: 1px; background: var(--cromo-oscuro); border-radius: var(--radio-chico);
  padding: .14rem .16rem;
}
.periodo-tira button {
  font: inherit; font-family: var(--rotulos); font-size: .62rem; letter-spacing: .03em;
  padding: .14rem .3rem; cursor: pointer; border: 0; border-radius: var(--radio-chico);
  background: transparent; color: var(--sobre-cromo);
}
.periodo-tira button:hover { background: color-mix(in srgb, var(--sobre-cromo) 16%, transparent); color: var(--sobre-cromo); }
.periodo-tira button[aria-pressed="true"] {
  background: var(--sobre-cromo); color: var(--cromo); font-weight: 700;
}
.borrar-filtros {
  font: inherit; font-family: var(--rotulos); font-size: .6rem; text-transform: uppercase;
  letter-spacing: .12em; color: var(--sobre-cromo); background: none; cursor: pointer;
  border: 1px solid color-mix(in srgb, var(--sobre-cromo) 70%, transparent); border-radius: var(--radio-chico); padding: .18rem .45rem;
}
.borrar-filtros:hover { background: color-mix(in srgb, var(--sobre-cromo) 16%, transparent); }

/* ---------- barra de filtros (chips), en las vistas de detalle ---------- */
.barra-filtros {
  background: var(--fondo-cuadro); border-bottom: 1px solid var(--borde);
  position: sticky; top: 0; z-index: 20;
  display: flex; flex-wrap: wrap; align-items: center; gap: .35rem 1rem;
  padding: .45rem .8rem;
}
.grupo-filtro { display: flex; flex-wrap: wrap; align-items: center; gap: .3rem; }
.grupo-filtro > .rotulo { margin-right: .15rem; }
.chips { display: flex; flex-wrap: wrap; gap: .25rem; }
.chips button {
  font: inherit; font-size: .78rem; font-weight: 600; padding: .14rem .6rem; cursor: pointer;
  border-radius: var(--radio-pildora); border: 1px solid var(--borde-panel);
  background: var(--fondo-cuadro); color: var(--texto);
  display: inline-flex; align-items: center; gap: .3rem;
}
.chips button:hover { background: var(--fondo-apoyo); }
.chips button[aria-pressed="true"] {
  background: var(--seleccion); color: var(--sobre-seleccion); border-color: var(--seleccion);
  font-weight: 700;
}
.chips .chip-ico { width: 1.05rem; height: 1.05rem; object-fit: contain; }
.filtro-select {
  font: inherit; font-size: .82rem; padding: .22rem 1.5rem .22rem .5rem;
  border: 1px solid var(--borde-panel); border-radius: var(--radio-pildora);
  background: var(--fondo-cuadro); color: var(--texto); max-width: 15rem;
}

/* Variantes de icono (asignacion en site/iconos-cultivo.yaml): B&W en reposo, COLOR en el
   seleccionado y en la tarjeta de contexto, que es como se ve en la captura del 10-ago. */
.ico-color { display: none; }
[aria-pressed="true"] .ico-bn { display: none; }
[aria-pressed="true"] .ico-color { display: inline-block; }

main { padding: .55rem .8rem 1rem; flex: 1 1 auto; }

/* ---------- pie ---------- */
.pie-sitio { border-top: 1px solid var(--borde); padding: .6rem .8rem 1rem; }
.pie-tec { margin: 0 0 .25rem; font-size: .8rem; font-weight: 650; font-style: italic; }
.pie-linea { margin: 0; font-size: .74rem; color: var(--texto-apoyo); }
.pie-menor { font-size: .7rem; margin-top: .15rem; }

/* ---------- tipografia general ---------- */
h1 {
  font-family: var(--titulos); font-size: 1.5rem; margin: 0 0 .3rem; font-weight: 400;
  letter-spacing: -.01em;
}
h2 { font-size: 1rem; margin: 0; font-weight: 650; }
h3 {
  font-family: var(--rotulos); font-size: .7rem; margin: 1.75rem 0 .6rem; font-weight: 600;
  color: var(--texto-apoyo); text-transform: uppercase; letter-spacing: .12em;
}
a { color: var(--enlace); }
.bajada { color: var(--texto-apoyo); margin: 0 0 1.1rem; max-width: 68ch; font-size: .9rem; }

/* ---------- fila de indicadores (KPIs) ----------
   Cajas blancas con borde fino, rotulo en negrita, numero grande y unidad al lado, como los
   recuadros de totales del mockup de JC. */
.kpis {
  display: grid; gap: .55rem; margin: 0 0 .55rem;
  grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
}
.kpi {
  background: var(--fondo-cuadro); border-radius: var(--radio); padding: .5rem .8rem .55rem;
  border: 1px solid var(--borde-panel);
}
.kpi-etiqueta {
  display: block; margin-bottom: .15rem;
  font-family: inherit; font-size: .78rem; font-weight: 700; text-transform: none;
  letter-spacing: 0; color: var(--texto);
}
.kpi-cifra { display: flex; align-items: baseline; gap: .3rem; }
.kpi-valor {
  font-size: 1.7rem; font-weight: 700; letter-spacing: -.02em; line-height: 1.05;
  font-variant-numeric: tabular-nums;
}
.kpi-unidad { font-size: .8rem; font-weight: 650; color: var(--texto-apoyo); }
.kpi-var { display: block; margin-top: .2rem; font-size: .74rem; color: var(--texto-apoyo); }
.kpi-var b { font-weight: 650; }
.kpi-var .var-pos { color: var(--positivo); }
.kpi-var .var-neg { color: var(--negativo); }
.kpi-var .var-cero { color: var(--neutro); }

/* Tarjeta de contexto del mockup de JC: icono del cultivo (variante color) + nombre +
   campaña, pegada a la izquierda de los indicadores. */
.kpi-contexto { display: flex; align-items: center; gap: .55rem; }
.kpi-contexto-ico { flex: 0 0 auto; width: 2.9rem; height: 2.9rem; }
.kpi-contexto-ico img { width: 100%; height: 100%; object-fit: contain; }
.kpi-contexto-texto { min-width: 0; }
.kpi-contexto-nombre {
  display: block; font-size: 1.15rem; font-weight: 700; letter-spacing: -.01em;
  line-height: 1.15; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.kpi-contexto-detalle { display: block; margin-top: .1rem; color: var(--texto-apoyo); font-size: .78rem; }

/* Aclaracion de unidades abreviadas de los indicadores ("* M ha: millones de hectáreas").
   La exige formato_v1.unidades_abreviadas. */
.kpis-nota { margin: -.3rem 0 .5rem; font-size: .7rem; color: var(--texto-apoyo); }
.kpis-nota:empty { display: none; }
/* Adentro de la grilla la nota vive en la misma celda que los indicadores. */
.kpis-grilla .kpis-nota { margin: 0; grid-column: 1 / -1; }

/* ---------- grilla del tablero ----------
   12 columnas. Cada bloque declara cuantas ocupa (`data-ancho`), asi el layout vive en el
   spec del tablero y no aca: agregar o mover un panel es editar un YAML. */
.tablero { display: grid; grid-template-columns: repeat(12, 1fr); gap: .55rem; }
.tablero > [data-ancho] { grid-column: span 4; }
.tablero > [data-ancho="3"] { grid-column: span 3; }
.tablero > [data-ancho="4"] { grid-column: span 4; }
.tablero > [data-ancho="5"] { grid-column: span 5; }
.tablero > [data-ancho="6"] { grid-column: span 6; }
.tablero > [data-ancho="8"] { grid-column: span 8; }
.tablero > [data-ancho="12"] { grid-column: span 12; }
/* `alto: 2` deja dos paneles apilados al lado de uno alto; `alto: 3` es el mapa del tablero
   de cultivos, que ocupa la columna izquierda a lo alto del selector, los indicadores y la
   fila de graficos (disposicion de la captura del 10-ago). */
.tablero > [data-alto="2"] { grid-row: span 2; }
.tablero > [data-alto="3"] { grid-row: span 3; }
@media (max-width: 1000px) {
  .tablero > [data-ancho], .tablero > .panel { grid-column: span 12; }
  .tablero > [data-alto="2"], .tablero > [data-alto="3"] { grid-row: span 1; }
  /* El tablero del mockup (cultivos) se apila en una sola columna. */
  .tablero.con-selector { flex-direction: column; }
  .tablero.con-selector .fila-tablero { grid-template-columns: minmax(0, 1fr); }
}

/* La celda del selector y la de los indicadores dentro de la grilla (tablero con selector
   grande): los indicadores son una sub-grilla de tarjeta de contexto + 4 tarjetas. */
.kpis-grilla {
  margin: 0; grid-template-columns: minmax(9rem, 1.1fr) repeat(4, minmax(0, 1fr));
  gap: .45rem; align-content: stretch;
}

/* Tablero con el alto ya fijado por tablero.js (clase `alto-fijo`): entra entero en la ventana.
   Las filas se reparten ese alto y los graficos se estiran hasta donde haya lugar en vez de
   imponer su propio minimo. El `overflow: hidden` es el seguro: si una leyenda larga no entra,
   se recorta adentro del panel y no descuadra la grilla entera. */
/* `minmax(0, 1fr)` y no `1fr`: `1fr` es en realidad `minmax(auto, 1fr)`, o sea que la fila
   igual crece hasta el min-content de sus paneles y el tablero se pasa del alto que le fijamos.
   Con el minimo en 0 las filas miden lo que les toca y son los paneles los que se acomodan
   adentro. Es la unica linea que hace que el alto fijado se respete de verdad. */
.tablero.alto-fijo { grid-auto-rows: minmax(0, 1fr); }

/* ---------- disposicion del mockup Modelo 2 (cultivos, tercera tanda del 10-ago) ----------
   CALCADA de la captura (specs/fuentes/WhatsApp Image 2026-08-10 at 11.08.41.jpeg): dos
   columnas. La izquierda es el mapa GRANDE a lo alto con la tira de UTILIDADES debajo; la
   derecha lleva la grilla de chips de cultivo, la tarjeta de contexto + 4 KPIs, la fila de
   graficos (evolucion | participacion) y la fila de tablas (datos por campaña | ranking). */
.tablero.con-selector { display: flex; align-items: stretch; gap: .55rem; }
.tablero.con-selector > .col-mapa {
  flex: 0 0 29%; min-width: 0; display: flex; flex-direction: column; gap: .55rem;
}
.tablero.con-selector > .col-mapa > .panel[data-panel="mapa"] { flex: 1 1 auto; min-height: 0; }
.tablero.con-selector > .col-mapa > .panel-utilidades { flex: 0 0 auto; }
.tablero.con-selector > .col-datos {
  flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: .55rem;
}
.tablero.con-selector .fila-tablero {
  display: grid; grid-template-columns: minmax(0, 11fr) minmax(0, 9fr); gap: .55rem;
  min-height: 0;
}
/* La fila de tablas del mockup reparte 60/40 (la tabla de campañas en dos bloques es mas
   ancha que el ranking): medido sobre la captura y sobre el navegador, con 55/45 el bloque
   derecho de campañas perdia su ultima columna. */
.tablero.con-selector .fila-tablas { grid-template-columns: minmax(0, 12fr) minmax(0, 8fr); }
.tablero.con-selector .fila-tablero > .panel { min-width: 0; }
/* Celda izquierda de la fila de tablas: la tabla de campañas arriba y el panel estatico
   "Información relacionada" debajo, como en el mockup. La pila LLENA la celda: es lo que
   tapa el hueco en blanco que dejaba la tabla sola (cuarta tanda, proporciones_sin_huecos,
   sin estirar nada: la tabla mide lo suyo y el panel de links completa el resto). */
.tablero.con-selector .pila-tablas {
  display: flex; flex-direction: column; gap: .55rem; min-width: 0; min-height: 0;
}
.tablero.con-selector .pila-tablas > .panel[data-panel="tabla-datos"] {
  flex: 1 1 auto; min-height: 0;
}
.tablero.con-selector .pila-tablas > .panel-info { flex: 0 0 auto; }
.tablero.con-selector.alto-fijo .fila-tablero > .pila-tablas { min-height: 0; }
/* Con el alto fijado por tablero.js (una pantalla): chips y KPIs miden lo suyo y el alto
   sobrante se lo reparten las dos filas de paneles en partes iguales. */
.tablero.con-selector.alto-fijo > .col-datos > .panel-selector,
.tablero.con-selector.alto-fijo > .col-datos > .kpis { flex: 0 0 auto; }
.tablero.con-selector.alto-fijo .fila-tablero { flex: 1 1 0; }
.tablero.con-selector.alto-fijo .fila-tablero > .panel { min-height: 0; }
/* Sin alto fijado (ventanas bajas, la pagina scrollea): el mapa conserva un alto digno para
   que no vuelva a ser "una miniatura". */
.tablero.con-selector .panel[data-panel="mapa"] > .panel-cuerpo > .grafico { min-height: 430px; }
.tablero.con-selector.alto-fijo .panel[data-panel="mapa"] > .panel-cuerpo > .grafico { min-height: 0; }
/* Titulos de cuadro del mockup: centrados, compactos, en dos lineas si hace falta. Son los
   titulos LITERALES del protocolo de JC (los pinta tablero.js por combinacion). */
.tablero.con-selector .panel-cab-mockup { display: block; margin: 0 0 .3rem; }
.tablero.con-selector .panel-cab-mockup h2 {
  text-align: center; font-size: .76rem; line-height: 1.3; font-weight: 700;
}
.tablero.con-selector .panel-cab-mockup .panel-toggle { justify-content: center; margin-top: .25rem; }
/* Cabecera del mapa: el rotulo "Seleccione departamento" en su cajita, centrado, con el
   selector de variable (secuencia fija de JC) debajo. */
.tablero.con-selector .mapa-cab {
  display: flex; flex-direction: column; align-items: center; gap: .3rem; margin: 0 0 .35rem;
}
.tablero.con-selector .mapa-cab .mapa-accion {
  margin: 0; border: 1px solid var(--borde-panel); border-radius: var(--radio-pildora);
  padding: .16rem .7rem; font-weight: 650;
}
.tablero.con-selector.alto-fijo .panel > .panel-pie { margin-top: .3rem; padding-top: .3rem; }
.panel-sub:empty { display: none; }
/* Los `.panel` van con descendiente y no con hijo directo: dentro de .col-alta el panel ya
   no es hijo directo de .tablero y las reglas lo tienen que alcanzar igual. */
.tablero.alto-fijo .panel { overflow: hidden; padding: .55rem .75rem .6rem; }
/* Con el alto fijado todo el cromo del panel se compacta un punto: el alto es para el dato. */
.tablero.alto-fijo .panel > .panel-cab { margin-bottom: .45rem; }
.tablero.alto-fijo .panel > .panel-pie { margin-top: .45rem; padding-top: .4rem; }
/* El desborde se recorta ADENTRO del cuerpo: el pie de fuente es obligatorio y ningun
   contenido puede montarsele encima. */
.tablero.alto-fijo .panel > .panel-cuerpo { overflow: hidden; }
/* `min-height: 0` en el cuerpo es lo que hace que el pie del panel no se caiga afuera del
   recorte: sin eso un item de flexbox nunca se encoge por debajo de su contenido, el cuerpo
   se queda con el alto que pide su contenido y empuja al pie (la cita de fuente y el enlace al
   detalle) fuera del panel. La cabecera y el pie no se encogen: se encoge el cuerpo. */
.tablero.alto-fijo .panel > .panel-cuerpo { min-height: 0; }
.tablero.alto-fijo .panel > .panel-cab,
.tablero.alto-fijo .panel > .panel-pie { flex: 0 0 auto; }
.tablero.alto-fijo .panel[data-panel="anillo"] .anillo-caja,
.tablero.alto-fijo .panel[data-panel="anillo"] .anillo-caja > .grafico,
.tablero.alto-fijo .panel[data-panel="mapa"] > .panel-cuerpo > .grafico { min-height: 0; }
/* Anillo del tablero con selector (cultivos): SOLO el donut, grande, con nombre y porcentaje
   AFUERA de cada porcion, como en la captura del 10-ago. La leyenda en lista no se dibuja
   (los nombres viajan en las etiquetas del grafico, que arma tablero.js). SIN cifra central
   desde la cuarta tanda (anillo_sin_cifra_central): el total "(fina y gruesa)" va en la
   linea .anillo-total-linea bajo el donut y la nota aclaratoria se recorta a una linea. */
.tablero.con-selector .panel[data-panel="anillo"] .anillo-leyenda { display: none; }
.tablero.con-selector .panel[data-panel="anillo"] .anillo-caja {
  flex: 1 1 auto; height: auto; min-height: 130px;
}
.tablero.con-selector .panel[data-panel="anillo"] .anillo-caja > .grafico {
  height: 100%; min-height: 130px;
}
/* Con el alto fijado, el alto del donut lo decide el reparto flex (la nota queda abajo,
   entera): el minimo vuelve a 0 para que la caja no empuje a la nota fuera del recorte.
   Tres clases: le gana al minimo de arriba. */
.tablero.con-selector.alto-fijo .panel[data-panel="anillo"] .anillo-caja,
.tablero.con-selector.alto-fijo .panel[data-panel="anillo"] .anillo-caja > .grafico {
  min-height: 0;
}
.tablero.con-selector .panel[data-panel="anillo"] .anillo-nota { display: none; }
.tablero.con-selector .panel[data-panel="anillo"] .anillo-total-linea { flex: 0 0 auto; }
.tablero.con-selector .panel[data-panel="anillo"] .cuadro-nota {
  flex: 0 0 auto; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical;
  overflow: hidden; margin-top: .2rem; font-size: .62rem;
}
.tablero.alto-fijo .panel[data-panel="tendencia"] .grafico {
  height: auto; flex: 1 1 auto; min-height: 0;
}
/* El Top N es el unico panel cuyo alto lo manda el CONTENIDO (una barra por departamento) y no
   un grafico que se estira. Repartiendo las barras en el alto disponible entran siempre las N
   que pide el spec: con lugar de sobra quedan aireadas y con poco lugar quedan juntas, pero
   nunca se corta la ultima. Mostrar 4 de un "Top 5" seria publicar un dato equivocado. */
.tablero.alto-fijo > .panel[data-panel="top"] .lista-barras {
  flex: 1 1 auto; min-height: 0;
  display: flex; flex-direction: column; justify-content: space-between; gap: 0;
  /* Seguro: si aun compactadas las N filas no entran, se recortan adentro de la lista y no
     se montan sobre el pie de fuente, que es obligatorio y tiene que quedar legible. */
  overflow: hidden;
}
/* Adentro del tablero cada departamento va en UNA linea (nombre, riel y valor al lado) y no en
   dos como en las vistas de detalle. Motivo, para que no se "corrija" de vuelta: en el mockup el
   Top 5 va en dos lineas, pero el mockup no dibuja el pie de fuente y el protocolo de JC lo hace
   obligatorio en todo cuadro. Con pie, cinco departamentos en dos lineas no entran en la columna
   de la derecha en ninguna pantalla razonable, y se cortaba el quinto. Entre las dos reglas manda
   la de JC: la fuente se cita siempre, el Top se compacta.
   El alto de cada fila lo fija el NUMERO, no el riel: por eso se achica .lb-valor y no alcanza
   con bajar la altura del riel. */
.tablero.alto-fijo > .panel[data-panel="top"] .lista-barras li {
  margin: 0; display: flex; align-items: center; gap: .5rem;
}
.tablero.alto-fijo > .panel[data-panel="top"] .lb-nombre {
  flex: 0 0 7.5rem; margin: 0; font-size: .64rem;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.tablero.alto-fijo > .panel[data-panel="top"] .lb-puesto { flex-basis: 1.2rem; margin: 0; }
.tablero.alto-fijo > .panel[data-panel="top"] .lb-fila { flex: 1 1 auto; min-width: 0; }
.tablero.alto-fijo > .panel[data-panel="top"] .lb-riel { height: .4rem; }
.tablero.alto-fijo > .panel[data-panel="top"] .lb-valor { font-size: .72rem; line-height: 1.25; }
.tablero.alto-fijo > .panel[data-panel="top"] .lb-part { font-size: .64rem; min-width: 2.6rem; }
/* Con 10 puestos (el ranking del mockup) las filas van con el interlineado justo para que
   entren los diez: mostrar 8 de un "top 10" seria publicar un dato equivocado. */
.tablero.alto-fijo > .panel[data-panel="top"] .lista-barras li { line-height: 1.05; }
.tablero.alto-fijo > .panel[data-panel="top"] .lb-nombre { font-size: .6rem; }
.tablero.alto-fijo > .panel[data-panel="top"] .lb-valor { font-size: .7rem; }
.tablero.alto-fijo > .panel[data-panel="top"] .panel-sub { font-size: .7rem; }
/* Ranking del tablero con selector: TABLA calcada del mockup de JC (Puesto | Departamento |
   Superficie Semb. (ha) | % sobre Total prov.), dibujada por tablero.js cuando el JSON trae
   `columnas`. Comparte la piel de .tabla-datos. */
.tablero.con-selector .panel[data-panel="top"] .top-tabla {
  flex: 1 1 auto; min-height: 0; overflow: auto;
}
/* Los encabezados largos del mockup ("Superficie Cos. (Ha)", "% sobre Total prov.") van en
   DOS lineas, como los escribe JC: con nowrap la tabla del bloque derecho y la columna del
   porcentaje se salian del panel y el recorte se comia los numeros. Envolver el encabezado
   es lo que hace que los DATOS entren enteros; las celdas de datos siguen en una linea. */
.tablero.con-selector .panel[data-panel="tabla-datos"] thead th,
.tablero.con-selector .panel[data-panel="top"] thead th { white-space: normal; }
/* Dos bloques de 4 columnas lado a lado en ~460px de panel: tipografia compacta para que
   los DOS bloques entren enteros (con la del resto del sitio, el bloque derecho perdia su
   ultima columna bajo el recorte del panel). Medido en el navegador a 1440px. */
.tablero.con-selector .panel[data-panel="tabla-datos"] .tabla-datos { gap: .45rem; }
.tablero.con-selector .panel[data-panel="tabla-datos"] table { font-size: .64rem; }
/* Sin huecos (cuarta tanda, proporciones_sin_huecos): cuando el panel queda mas alto que sus
   filas (ventanas altas), las tablas se ESTIRAN a la caja y el aire se reparte entre las
   filas, que quedan aireadas como en el mockup; nada queda en blanco abajo. Con el alto
   justo la tabla mide su contenido y no se encoge: no deforma nada. */
.tablero.con-selector .panel[data-panel="tabla-datos"] .tabla-datos { align-items: stretch; }
.tablero.con-selector .panel[data-panel="tabla-datos"] .tabla-datos table,
.tablero.con-selector .panel[data-panel="top"] .top-tabla table { height: 100%; }
.tablero.con-selector .panel[data-panel="tabla-datos"] thead th { font-size: .5rem; letter-spacing: 0; }
.tablero.con-selector .panel[data-panel="tabla-datos"] th,
.tablero.con-selector .panel[data-panel="tabla-datos"] td { padding: .08rem .2rem; }
/* Las tablas del tablero (datos por campaña y ranking), con el alto fijado, scrollean
   ADENTRO del panel si no entran: nunca descuadran la grilla ni tapan el pie de fuente. */
.tablero.alto-fijo .panel[data-panel="tabla-datos"] .tabla-datos {
  flex: 1 1 auto; min-height: 0; overflow: auto;
}
/* Diez campañas en dos bloques de cinco (mockup literal, tercera tanda) + el top 10 de al
   lado: filas densas, filete apagado (a esta densidad raya mas de lo que separa; la fila
   marcada de la campaña elegida sigue haciendo de guia). Cortar una fila de un top 10 o de
   una serie de 10 seria publicar un dato equivocado; el scroll de arriba queda como seguro. */
.tablero.con-selector.alto-fijo .panel[data-panel="tabla-datos"] th,
.tablero.con-selector.alto-fijo .panel[data-panel="tabla-datos"] td,
.tablero.con-selector.alto-fijo .panel[data-panel="top"] th,
.tablero.con-selector.alto-fijo .panel[data-panel="top"] td {
  padding: .08rem .3rem;
}
.tablero.con-selector.alto-fijo .panel[data-panel="tabla-datos"] td,
.tablero.con-selector.alto-fijo .panel[data-panel="top"] td {
  font-size: .68rem; line-height: 1.15; border-bottom: 0;
}
/* La nota vacia no reserva renglon: esos 8px de margen son justo los que le faltaban a la
   ultima campaña de la tabla. Scoped al tablero de cultivos: en las otras secciones no se
   toca nada. */
.tablero.con-selector .panel .cuadro-nota:empty { display: none; }
/* Indicadores compactos del tablero con selector: la fila de KPIs de la captura es BAJA y
   va CENTRADA (rotulo arriba, numero grande con su unidad debajo, sin variacion: los KPIs
   de cultivos no la traen, kpis_sin_variacion). El numero entero entra porque los
   indicadores de cultivos no se abrevian. */
.tablero.con-selector .kpi { padding: .32rem .5rem .38rem; text-align: center; }
.tablero.con-selector .kpi-cifra { justify-content: center; }
.tablero.con-selector .kpi-valor { font-size: 1.28rem; }
.tablero.con-selector .kpi-etiqueta { margin-bottom: .08rem; font-size: .7rem; }
.tablero.con-selector .kpi-var:empty { display: none; }
.tablero.con-selector .kpi-contexto-ico { width: 2.3rem; height: 2.3rem; }
/* El nombre envuelve en vez de cortarse: "Todos los cultivos" entero antes que "Todos los c…". */
.tablero.con-selector .kpi-contexto-nombre { font-size: 1rem; white-space: normal; line-height: 1.1; }
.tablero.con-selector .kpi-contexto-detalle { font-size: .7rem; margin-top: .05rem; }
/* Mapa del tablero con selector: en la captura el mapa LLENA su columna y abajo quedan solo
   la escala y una linea de total, sin caja gris que le robe alto al dibujo. */
.tablero.con-selector .panel[data-panel="mapa"] .total-provincial {
  background: none; padding: 0; margin: .3rem 0 0; font-size: .74rem;
}
.tablero.con-selector .panel[data-panel="mapa"] .escala { margin: .35rem 0 0; }
.tablero.con-selector .panel[data-panel="mapa"] .mapa-accion { margin-bottom: .15rem; }

/* Pantallas bajas (notebooks de 13"): se achica lo que hay ARRIBA del tablero para que el alto
   se lo queden los paneles, que es lo que se mira. */
@media (max-height: 900px) {
  main { padding-top: .4rem; padding-bottom: .6rem; }
  .pestanias { margin-bottom: .4rem; }
  .pestanias a { padding: .28rem .6rem; }
  .kpi { padding: .35rem .65rem .4rem; }
  .kpi-valor { font-size: 1.45rem; }
  .kpi-etiqueta { margin-bottom: .1rem; font-size: .74rem; }
  .kpi-var { margin-top: .1rem; }
}

/* Panel apagado: la combinacion elegida no tiene datos. Se oculta el cuerpo y el pie, y queda
   el motivo escrito. El markup del cuerpo NO se destruye. */
.panel-vacio { display: none; margin: .5rem 0 0; font-size: .8rem; color: var(--texto-apoyo); }
.panel.sin-datos .panel-cuerpo > *:not(.panel-vacio) { display: none; }
.panel.sin-datos .panel-pie { display: none; }
.panel.sin-datos .panel-vacio { display: block; }

/* ---------- panel ----------
   Caja con borde fino visible (tema del 10-ago): sobre lienzo blanco, el borde es lo que
   recorta el panel. */
.panel {
  background: var(--fondo-cuadro); border-radius: var(--radio); padding: .7rem .85rem .8rem;
  border: 1px solid var(--borde-panel); display: flex; flex-direction: column; min-width: 0;
}
.panel-cab {
  display: flex; align-items: baseline; gap: .75rem; margin: 0 0 .55rem; padding: 0;
}
.panel-cab h2 { flex: 1 1 auto; min-width: 0; font-size: .95rem; }
.panel-sub { margin: .15rem 0 0; font-size: .76rem; color: var(--texto-apoyo); }
/* Los paneles altos (los que ocupan mas de una fila) tienen que estirar su grafico para llenar
   la columna: si no, quedan con un hueco abajo del tamaño de la diferencia contra la columna de
   al lado. El min-height es el piso de seguridad: si el flex resolviera 0, ECharts dibujaria
   sobre un contenedor sin alto y no se veria nada. */
.panel-cuerpo { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; }
.panel[data-panel="anillo"] .anillo-caja { flex: 1 1 auto; min-height: 240px; }
.panel[data-panel="anillo"] .anillo-caja > .grafico { height: 100%; min-height: 240px; }
.panel[data-panel="mapa"] > .panel-cuerpo > .grafico { flex: 1 1 auto; height: auto; min-height: 300px; }
.panel[data-panel="tendencia"] .grafico { height: 190px; }
/* Los toggles internos del panel (PROD. / SEMBRADA / REND.) son chips cuadrados y chicos:
   no compiten con los chips del selector de cultivo. */
.panel-toggle { display: flex; gap: .2rem; flex: 0 0 auto; }
.panel-toggle button {
  font: inherit; font-family: var(--rotulos); font-size: .62rem; text-transform: uppercase;
  letter-spacing: .08em; padding: .2rem .4rem; cursor: pointer; border-radius: var(--radio-chico);
  border: 1px solid var(--borde-panel); background: var(--fondo-cuadro); color: var(--texto-apoyo);
}
.panel-toggle button[aria-pressed="true"] {
  background: var(--seleccion); border-color: var(--seleccion); color: var(--sobre-seleccion);
}
.panel-pie {
  margin: .55rem 0 0; padding-top: .45rem; border-top: 1px solid var(--fondo-apoyo);
  display: flex; align-items: baseline; gap: .75rem;
  font-size: .7rem; color: var(--texto-apoyo);
}
.panel-fuente { flex: 1 1 auto; min-width: 0; }
.panel-detalle {
  flex: 0 0 auto; font-family: var(--rotulos); font-size: .64rem; text-transform: uppercase;
  letter-spacing: .1em; color: var(--enlace); text-decoration: none; white-space: nowrap;
}
.panel-detalle:hover { text-decoration: underline; }

/* ---------- selector grande de cultivo (grilla de cajitas, captura del 10-ago) ----------
   Icono a la izquierda (B&W; color cuando el cultivo esta elegido) + nombre en cajita con
   borde; el elegido se pinta de verde; "Todos" en caja grande a la derecha, a lo alto de las
   dos filas. */
.panel-selector { padding: .4rem .55rem; justify-content: center; }
/* 7 columnas de cultivos + la del "Todos": con los 14 cultivos del catalogo de JC quedan las
   dos filas de a 7 de la captura del 10-ago. Un cultivo nuevo (alta por catalogo) abre una
   tercera fila sin romper nada. */
.selector-cultivo {
  display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)) minmax(3.6rem, .8fr);
  gap: .25rem .35rem; align-items: center;
}
.selector-cultivo button { font: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
.chip-cultivo { display: flex; align-items: center; gap: .25rem; min-width: 0; }
.chip-ico-caja { flex: 0 0 auto; width: 1.45rem; height: 1.45rem; }
.chip-ico-caja img { width: 100%; height: 100%; object-fit: contain; display: none; }
.chip-ico-caja .ico-bn { display: block; }
.chip-cultivo[aria-pressed="true"] .ico-bn { display: none; }
.chip-cultivo[aria-pressed="true"] .ico-color { display: block; }
.chip-nombre {
  flex: 1 1 auto; min-width: 0; border: 1px solid var(--borde-panel);
  border-radius: var(--radio-pildora);
  background: var(--fondo-cuadro); color: var(--texto); font-size: .7rem; font-weight: 650;
  padding: .14rem .15rem; text-align: center;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.chip-cultivo:hover .chip-nombre { background: var(--fondo-apoyo); }
.chip-cultivo[aria-pressed="true"] .chip-nombre {
  background: var(--seleccion); border-color: var(--seleccion); color: var(--sobre-seleccion);
}
.chip-grande {
  grid-column: 8; grid-row: 1 / span 2; align-self: stretch;
  border: 1px solid var(--borde-panel) !important; border-radius: var(--radio);
  background: var(--fondo-cuadro) !important; color: var(--texto) !important;
  font-size: 1.05rem !important; font-weight: 650;
}
.chip-grande:hover { background: var(--fondo-apoyo) !important; }
.chip-grande[aria-pressed="true"] {
  background: var(--seleccion) !important; border-color: var(--seleccion) !important;
  color: var(--sobre-seleccion) !important;
}
/* En angosto la grilla del selector se relaja a cajitas fluidas. */
@media (max-width: 1000px) {
  .selector-cultivo { display: flex; flex-wrap: wrap; }
  .chip-grande { align-self: auto; padding: .16rem .6rem; }
}

/* ---------- panel UTILIDADES (estatico, iconos "Proximamente") ----------
   Tira BAJA y ancha, como en la captura del 10-ago: titulo centrado y los dos items LADO A
   LADO. El alto lo pone el contenido (en .col-alta el panel no se estira: flex 0 0 auto). */
.panel-utilidades {
  justify-content: flex-start; padding: .45rem .55rem .5rem;
}
.utilidades-titulo {
  text-align: center; font-size: .88rem; font-weight: 700; letter-spacing: .06em;
  color: var(--texto-apoyo); margin: 0 0 .35rem;
}
.utilidades-items {
  flex: 1 1 auto; display: flex; flex-direction: row; align-items: center;
  justify-content: space-between; gap: .4rem 0; flex-wrap: wrap;
}
.utilidad {
  display: flex; align-items: center; gap: .25rem; font-weight: 650; font-size: .7rem;
  opacity: .6; cursor: not-allowed; white-space: nowrap; min-width: 0;
}
.utilidad img { width: 1.4rem; height: 1.4rem; object-fit: contain; }
/* El item ACTIVO del panel (hoy solo "Exportar como PDF"): es un <button> de verdad, asi que
   hay que sacarle el cromo que le pone el navegador. Va sin el apagado ni el cursor tachado
   del resto y sin rotulo "Proximamente": se ve como lo que es, algo en lo que se hace clic. */
.utilidad-activa {
  font: inherit; font-size: .7rem; font-weight: 650; color: inherit;
  background: none; border: 0; padding: 0; opacity: 1; cursor: pointer;
}
.utilidad-activa:hover .utilidad-nombre { text-decoration: underline; }
.utilidad-activa:focus-visible { outline: 2px solid var(--enlace); outline-offset: 2px; }
/* Copia del grafico a alta resolucion para imprimir: vive escondida hasta que se imprime
   (la cuelga comun.js al lado del canvas). */
.grafico-impreso { display: none; }
.utilidad .prox {
  color: var(--texto-apoyo); font-size: .48rem; padding: .04rem .18rem;
  letter-spacing: .02em;
}

/* ---------- panel "Información relacionada" (estatico, links "Proximamente") ----------
   El bloque del mockup, dibujado deshabilitado (cuarta tanda,
   informacion_relacionada_se_dibuja): titulo a la izquierda y los cinco links del mockup en
   dos columnas, con la flechita verde con que JC los dibuja. */
.panel-info { justify-content: flex-start; padding: .35rem .6rem .4rem; }
.info-titulo { margin: 0 0 .22rem; font-size: .74rem; font-weight: 700; }
/* Columna izquierda mas ancha, como en el mockup: ahi caen los rotulos largos ("Calendario
   de siembra y cosecha") y con mitades iguales se truncaban. */
.info-items {
  margin: 0; padding: 0; list-style: none;
  display: grid; grid-template-columns: 1.3fr 1fr; gap: .08rem .6rem;
}
.info-item {
  display: flex; align-items: center; gap: .3rem; font-size: .66rem; font-weight: 650;
  opacity: .6; cursor: not-allowed; min-width: 0; white-space: nowrap;
}
.info-nombre { overflow: hidden; text-overflow: ellipsis; }
.info-nombre::before { content: "› "; color: var(--seleccion); font-weight: 700; }
.info-item .prox {
  color: var(--texto-apoyo); font-size: .44rem; padding: .03rem .14rem; letter-spacing: .02em;
}

/* Anillo con total al centro (hacienda, stock). El total va en HTML y no dibujado por
   ECharts: asi se puede leer con lector de pantalla y no se pixela al reescalar. En cultivos
   el centro no se dibuja (cuarta tanda) y el total va en la linea de abajo. */
.anillo-caja { position: relative; }
.anillo-total-linea {
  margin: .1rem 0 0; text-align: center; font-size: .72rem; font-weight: 650;
  font-variant-numeric: tabular-nums;
}
.anillo-total-linea:empty { display: none; }
/* El 50% NO es arbitrario: tiene que ser el mismo valor que el `center` de la serie de ECharts
   en site/assets/js/tablero.js. Si uno se mueve, el texto se despega del agujero del anillo. */
.anillo-centro {
  position: absolute; left: 0; right: 0; top: 50%; transform: translateY(-50%);
  text-align: center; pointer-events: none;
}
.anillo-total {
  font-size: 1.6rem; font-weight: 680; letter-spacing: -.02em; font-variant-numeric: tabular-nums;
}
.anillo-unidad { display: block; margin-top: .1rem; }
.anillo-nota { display: block; font-size: .68rem; color: var(--texto-apoyo); margin-top: .1rem; }
.anillo-leyenda {
  margin: .5rem 0 0; padding: 0; list-style: none; font-size: .8rem;
  display: grid; grid-template-columns: 1fr 1fr; gap: .1rem .9rem;
}
.anillo-leyenda li { display: flex; align-items: center; gap: .4rem; }
.anillo-leyenda .muestra {
  width: .6rem; height: .6rem; border-radius: var(--radio-chico); flex: 0 0 auto;
}
.anillo-leyenda .nombre {
  flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.anillo-leyenda .pct { font-variant-numeric: tabular-nums; font-weight: 650; }

/* Rotulo de accion del mapa del tablero ("Seleccione departamento", mockup de JC). */
.mapa-accion { margin: 0 0 .3rem; }
.mapa-accion:empty { display: none; }

/* Forma `tabla-datos`: los numeros crudos bajo el grafico de evolucion (mockup Modelo 2).
   DOS bloques de campañas lado a lado, como los dibuja JC (tercera tanda, mockup literal;
   deroga la "una sola serie" de la segunda tanda, backlog 38). El hueco que dejaba la tabla
   se llena con el panel "Información relacionada" apilado debajo (cuarta tanda,
   proporciones_sin_huecos). */
.tabla-datos { display: flex; gap: .6rem; align-items: flex-start; }
.tabla-datos table { flex: 1 1 0; border-collapse: collapse; width: 100%; font-size: .72rem; }
.tabla-datos th, .tabla-datos td {
  padding: .16rem .3rem; border-bottom: 1px solid var(--fondo-apoyo); white-space: nowrap;
}
.tabla-datos thead th {
  text-align: left; border-bottom: 1px solid var(--borde);
  font-family: var(--rotulos); font-size: .55rem; text-transform: uppercase;
  letter-spacing: .04em; color: var(--texto-apoyo); font-weight: 600;
}
.tabla-datos td.num, .tabla-datos th.num { text-align: right; font-variant-numeric: tabular-nums; }
/* La campaña elegida en la barra verde queda marcada: el dato de la pantalla es ese. */
.tabla-datos tr.actual td { background: var(--fondo-apoyo); font-weight: 650; }

/* Lista de barras (Top N): nombre arriba, barra y valor abajo. */
.lista-barras { margin: 0; padding: 0; list-style: none; }
.lista-barras li { margin: 0 0 .55rem; }
.lista-barras li:last-child { margin-bottom: 0; }
.lb-puesto {
  flex: 0 0 1.5rem; font-family: var(--rotulos); font-size: .66rem; color: var(--texto-apoyo);
  font-variant-numeric: tabular-nums;
}
/* Fuera del alto fijo (paneles apilados en angosto) el puesto comparte renglon con el nombre. */
.lista-barras .lb-puesto { display: inline-block; margin-right: .3rem; }
.lista-barras .lb-puesto + .lb-nombre { display: inline-block; }
.lb-part {
  flex: 0 0 auto; font-size: .7rem; color: var(--texto-apoyo);
  font-variant-numeric: tabular-nums; min-width: 3.2rem; text-align: right;
}
.lb-nombre {
  font-family: var(--rotulos); font-size: .68rem; letter-spacing: .06em; text-transform: uppercase;
  display: block; margin-bottom: .2rem;
}
.lb-fila { display: flex; align-items: center; gap: .6rem; }
.lb-riel {
  flex: 1 1 auto; height: .5rem; background: var(--fondo-apoyo); border-radius: var(--radio-chico);
  overflow: hidden;
}
/* display:block es obligatorio: un <span> inline ignora width y height y la barra no se ve. */
.lb-barra { display: block; height: 100%; background: var(--primario-medio); border-radius: var(--radio-chico); }
.lb-valor {
  flex: 0 0 auto; font-size: .82rem; font-variant-numeric: tabular-nums; font-weight: 650;
}

/* Barra de escala del mapa compacto: reemplaza a la leyenda en lista cuando no hay lugar. */
.escala { display: flex; align-items: center; gap: .5rem; margin: .5rem 0 0; }
.escala-min, .escala-max {
  font-family: var(--rotulos); font-size: .62rem; color: var(--texto-apoyo); flex: 0 0 auto;
}
.escala-rampa { flex: 1 1 auto; height: .45rem; border-radius: var(--radio-chico); }

/* ---------- cuadros de las vistas de detalle ----------
   Misma piel que los paneles del tablero: una vista de detalle es un panel grande. */
.cuadro {
  background: var(--fondo-cuadro); border-radius: var(--radio);
  border: 1px solid var(--borde-panel); margin: 0 0 .75rem; padding: .9rem 1rem 1rem;
}
.cuadro-cab { display: flex; align-items: baseline; gap: .75rem; margin: 0 0 .75rem; padding: 0; }
.cuadro-cab > div { flex: 1 1 auto; min-width: 0; }
.titulo-protocolo {
  font-family: var(--titulos); font-size: 1.1rem; line-height: 1.3; font-weight: 400;
}
.subtitulo { margin: .15rem 0 0; font-size: .78rem; color: var(--texto-apoyo); }
.grafico { width: 100%; height: 360px; }
.grafico.alto { height: 480px; }
.grafico.chico { height: 200px; }
.pie-fuente {
  margin: .7rem 0 0; font-size: .7rem; color: var(--texto-apoyo);
  border-top: 1px solid var(--fondo-apoyo); padding-top: .55rem;
}
.cuadro-nota { margin: .5rem 0 0; font-size: .76rem; color: var(--texto-apoyo); }

/* Los badges de tipo de cuadro ("Anillo", "Mapa", "Barras") se sacaron el 10-ago-2026 por
   regla de JC (formato_v1.sin_leyendas_de_tipo_de_grafico). */

/* ---------- mapa ---------- */
.mapa-fila { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
             gap: .75rem; align-items: start; }
@media (max-width: 900px) { .mapa-fila { grid-template-columns: 1fr; } }
.mapa-fila > .cuadro { margin-bottom: 0; min-width: 0; }
.mapa-fila .tabla-scroll { max-height: 28rem; overflow-y: auto; }
.mapa-fila tbody tr { cursor: pointer; }
.leyenda { margin: .5rem 0 0; font-size: .8rem; }
.leyenda-encabezado { font-family: var(--rotulos); font-size: .66rem; text-transform: uppercase;
                      letter-spacing: .1em; color: var(--texto-apoyo); margin: 0 0 .3rem; }
.leyenda ul { list-style: none; margin: 0; padding: 0; }
.leyenda li { display: flex; align-items: center; gap: .45rem; margin: .1rem 0; }
.leyenda .muestra { width: 1rem; height: .7rem; border-radius: var(--radio-chico); flex: 0 0 auto; }
.leyenda .conteo { color: var(--texto-apoyo); }
.total-provincial {
  margin: .6rem 0 0; padding: .5rem .65rem; background: var(--fondo-apoyo);
  border-radius: var(--radio-chico); font-size: .85rem; font-weight: 600;
}
.advertencia-escala { margin: .5rem 0 0; font-size: .72rem; color: var(--texto-apoyo);
                      max-width: 58ch; }

/* ---------- tablas ---------- */
.tabla-scroll { overflow-x: auto; }
table.datos { border-collapse: collapse; width: 100%; font-size: .82rem; }
table.datos th, table.datos td { padding: .32rem .5rem; border-bottom: 1px solid var(--fondo-apoyo);
                                 white-space: nowrap; }
table.datos thead th {
  text-align: left; border-bottom: 1px solid var(--borde); background: var(--fondo-cuadro);
  font-family: var(--rotulos); font-size: .64rem; text-transform: uppercase;
  letter-spacing: .08em; color: var(--texto-apoyo); font-weight: 600;
}
table.datos td.num, table.datos th.num { text-align: right; font-variant-numeric: tabular-nums; }
table.datos tbody tr.resaltada { background: var(--resaltado); }
table.datos tr.fila-total td { background: var(--fondo-apoyo); font-weight: 650; }
table.datos td.primera-col, table.datos th.primera-col {
  position: sticky; left: 0; background: var(--fondo-cuadro);
}
table.datos tr.fila-total td.primera-col { background: var(--fondo-apoyo); }
table.datos td.destacada { font-weight: 700; color: var(--enlace); }

/* ---------- matriz origen-destino (tipo flujo-od) ---------- */
/* 27 x 27 celdas. La primera columna y el encabezado quedan fijos al hacer scroll: sin eso,
   para leer una celda del medio hay que acordarse de que fila y que columna era. */
.matriz-scroll { max-height: 32rem; overflow: auto; }
table.matriz-od { font-size: .72rem; }
table.matriz-od th, table.matriz-od td { padding: .18rem .35rem; }
table.matriz-od thead th { position: sticky; top: 0; z-index: 2; }
table.matriz-od thead th.primera-col { z-index: 3; }
table.matriz-od th.vertical { writing-mode: vertical-rl; transform: rotate(180deg);
                              text-align: left; font-weight: 500; }
table.matriz-od td.sobre-oscuro { color: var(--sobre-cromo); }
table.matriz-od td.diagonal { outline: 2px solid var(--secundario); outline-offset: -2px; }
table.matriz-od td.total-fila { font-weight: 650; background: var(--fondo-apoyo); }
table.matriz-od tfoot td { font-weight: 650; background: var(--fondo-apoyo);
                           border-top: 1px solid var(--borde); }
table.matriz-od th.esquina { font-weight: 500; color: var(--texto-apoyo); }

.var-pos { color: var(--positivo); }
.var-neg { color: var(--negativo); }
.var-cero { color: var(--neutro); }
.sd { color: var(--texto-apoyo); }

/* ---------- resumen: los indicadores de un cuadro, arriba del grafico ---------- */
.resumen { display: flex; flex-wrap: wrap; gap: .5rem; margin: 0 0 .8rem; }
.resumen:empty { display: none; }
.resumen div {
  min-width: 9rem; background: var(--fondo-apoyo); border-radius: var(--radio-chico); padding: .45rem .7rem;
}
.resumen .etiqueta {
  display: block; font-family: var(--rotulos); font-size: .62rem; text-transform: uppercase;
  letter-spacing: .1em; color: var(--texto-apoyo);
}
.resumen .valor {
  font-size: 1.15rem; font-weight: 680; font-variant-numeric: tabular-nums;
  letter-spacing: -.01em;
}

/* ---------- home ---------- */
.ramas { display: grid; gap: .75rem; grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
         padding: 0; margin: .5rem 0 0; list-style: none; }
.rama {
  background: var(--fondo-cuadro); border: 1px solid var(--borde-panel); border-radius: var(--radio);
  padding: .9rem 1rem 1rem;
}
.rama h2 { font-size: 1rem; }
.rama-bajada { color: var(--texto-apoyo); font-size: .84rem; margin: .3rem 0 .6rem; }
.rama-estado {
  display: inline-block; font-family: var(--rotulos); font-size: .62rem; text-transform: uppercase;
  letter-spacing: .12em; padding: .1rem .4rem; border-radius: var(--radio-chico); margin-bottom: .5rem;
}
.rama-estado.con-datos { background: var(--seleccion); color: var(--sobre-seleccion); }
.rama-estado.sin-datos { background: var(--fondo-apoyo); color: var(--texto-apoyo); }
.rama ul { margin: .4rem 0 0; padding-left: 1rem; font-size: .84rem; }
.rama li { margin: .12rem 0; }
.rama .pendiente { color: var(--texto-apoyo); }

/* Tarjetas de la lista de vistas ("Analisis completo"). */
.grupo-vistas { display: grid; gap: .5rem; grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
                padding: 0; margin: 0 0 1rem; list-style: none; }
/* Las tarjetas de una fila tienen que medir todas lo mismo aunque los titulos ocupen distinta
   cantidad de renglones: si no, la grilla queda escalonada. */
.grupo-vistas li { display: flex; }
.tarjeta {
  display: block; width: 100%; background: var(--fondo-cuadro); border: 1px solid var(--borde-panel);
  border-radius: var(--radio); padding: .7rem .85rem; text-decoration: none; color: var(--texto);
}
.tarjeta:hover { border-color: var(--enlace); background: var(--fondo-apoyo); }
.tarjeta-titulo { font-weight: 650; display: block; font-size: .92rem; }
.tarjeta-sub { color: var(--texto-apoyo); font-size: .8rem; display: block; margin-top: .2rem; }
.tarjeta-tipo {
  display: block; margin-top: .35rem; font-family: var(--rotulos); font-size: .62rem;
  text-transform: uppercase; letter-spacing: .12em; color: var(--texto-apoyo);
}

/* ---------- pestañas Tablero / Analisis completo ---------- */
.pestanias { display: flex; gap: .3rem; margin: 0 0 .8rem; border-bottom: 1px solid var(--borde); }
.pestanias a {
  font-family: var(--rotulos); font-size: .68rem; text-transform: uppercase; letter-spacing: .1em;
  padding: .35rem .7rem; text-decoration: none; color: var(--texto-apoyo);
  border-bottom: 2px solid transparent; margin-bottom: -1px;
}
.pestanias a:hover { color: var(--texto); }
.pestanias a[aria-current] { color: var(--texto); border-bottom-color: var(--seleccion); }

/* ---------- notas metodologicas y avisos ---------- */
.notas { margin: 1.25rem 0 0; }
.notas details {
  background: var(--fondo-cuadro); border: 1px solid var(--borde); border-radius: var(--radio);
  padding: .5rem .75rem; margin: 0 0 .35rem;
}
.notas summary { cursor: pointer; font-size: .85rem; font-weight: 650; }
.notas p { margin: .5rem 0 0; font-size: .84rem; color: var(--texto-apoyo); max-width: 70ch; }
.aviso {
  border-left: 3px solid var(--cromo); background: var(--fondo-apoyo);
  border-radius: 0 var(--radio-chico) var(--radio-chico) 0; padding: .6rem .8rem; margin: 0 0 .75rem; font-size: .84rem;
  max-width: 78ch;
}
.aviso.reservado { border-left-color: var(--negativo); }
.enlaces { margin: 1.25rem 0 0; font-size: .85rem; }
.enlaces a { margin-right: 1rem; }
.noscript {
  border-left: 3px solid var(--negativo); background: var(--fondo-apoyo);
  padding: .6rem .8rem; margin: 0 0 .75rem; font-size: .84rem;
}
.dos-columnas { display: grid; grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
                gap: .75rem; }

/* ---------- angosto: el menu lateral pasa arriba ---------- */
@media (max-width: 1000px) {
  .marco { flex-direction: column; }
  .menu-lateral { flex: 0 0 auto; }
  .cabecera { flex-wrap: wrap; }
  .cabecera-logo { min-width: 0; }
  .kpis-grilla { grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); }
}

/* El "tema moderno" de cultivos (segunda tanda del 10-ago: body.tema-cultivos, menu lateral
   discreto, sombras) quedo DEROGADO por la tercera tanda del mismo dia: JC rechazo el
   rediseño ("Todo deformado Facu") y el mockup Modelo 2 volvio a mandar de forma literal,
   diseño incluido (formato_v1.tercera_tanda.mockup_literal). El cromo verde de arriba ES el
   de la captura; no hay tema alternativo. */

/* ---------- impresion: "Exportar como PDF" del panel UTILIDADES ----------
   El boton imprime la pagina y el PDF lo arma el navegador, asi que ESTE bloque es el
   formato del PDF. Se imprime el INFORME: la cabecera con el logo, la banda con la ruta (que
   dice el cultivo elegido), los indicadores y los cuadros con sus fuentes, y el pie con la
   fecha de los datos. NO se imprimen los CONTROLES (menu, pestañitas de campaña, chips de
   cultivo, barra de filtros, "Volver", botones de cabecera) ni los bloques que en pantalla
   estan deshabilitados (el propio panel de UTILIDADES e "Información relacionada"): en papel
   no se puede hacer clic y solo ocupan lugar. El tablero entra en UNA hoja apaisada, que es
   la misma idea que en pantalla: cuatro paneles de un vistazo, no un informe largo.

   Por que `body.imprimiendo` y no `@media print`: los graficos son canvas y hay que sacarles
   una foto ANTES de imprimir (ver comun.js). Para que la foto salga con las proporciones de
   la HOJA y no con las de la ventana, comun.js pone esta clase, deja que los graficos se
   redibujen en la caja de la hoja, saca la foto e imprime con la clase todavia puesta. Una
   sola descripcion del formato sirve para la foto, para lo que se ve un instante en pantalla
   y para lo que sale impreso; con @media print habria dos y podrian discrepar. */
@media print { @page { size: A4 landscape; margin: 8mm; } }

/* La clase va en <html> y no en <body> para poder tocar el tamaño de la raiz: TODO el sitio
   mide en rem, asi que bajar la raiz achica de una sola vez tipografias, aires y altos
   minimos, en la misma proporcion. Es lo que hace entrar el tablero en la hoja: en A4
   apaisado hay bastante menos alto util que en una pantalla, y a tamaño de pantalla el
   ranking salia cortado y los graficos quedaban en una tirita. 87,5% = 14px de raiz. */
.imprimiendo { font-size: 87.5%; }

/* La caja de la hoja: A4 apaisado (297x210mm) menos los 8mm de margen de @page. Es el unico
   numero de esta hoja de estilo que sale del papel y no del contenido. */
.imprimiendo body {
  width: 281mm; height: 194mm; min-height: 0; overflow: hidden;
  font-size: .95rem;   /* el cuerpo mide en px: se vuelve a poner en rem para que escale */
  /* Sin esto el navegador no imprime los FONDOS: la cabecera cocoa saldria blanca con el
     logo crema encima (o sea invisible), y los totales y los chips perderian su lectura. */
  -webkit-print-color-adjust: exact; print-color-adjust: exact;
}
.imprimiendo .menu-lateral, .imprimiendo .pestanias, .imprimiendo .barra-filtros,
.imprimiendo .periodo, .imprimiendo .borrar-filtros, .imprimiendo .boton-cabecera,
.imprimiendo .cabecera-banderas, .imprimiendo .panel-selector,
.imprimiendo .panel-utilidades, .imprimiendo .panel-info,
.imprimiendo .noscript { display: none; }

/* El alto de una PANTALLA lo fija tablero.js en el estilo del nodo (.alto-fijo); en papel lo
   manda la hoja. El tablero se queda con lo que sobra despues de la cabecera, la banda y el
   pie: el mismo reparto que en pantalla y sin un segundo numero magico. */
.imprimiendo main { display: flex; flex-direction: column; min-height: 0; }
.imprimiendo #tablero { height: auto !important; flex: 1 1 auto; min-height: 0; }

/* La hoja mide 281mm de ancho aunque la VENTANA sea angosta, asi que aca no puede mandar el
   corte de 1000px: sin esto, exportar desde una ventana chica sacaria la foto con las dos
   columnas apiladas y el PDF saldria distinto de lo que se imprime. */
.imprimiendo .marco { flex-direction: row; }
.imprimiendo .cabecera { flex-wrap: nowrap; }
.imprimiendo .tablero.con-selector { flex-direction: row; }
.imprimiendo .tablero.con-selector .fila-tablero {
  grid-template-columns: minmax(0, 11fr) minmax(0, 9fr);
}
.imprimiendo .tablero.con-selector .fila-tablas {
  grid-template-columns: minmax(0, 12fr) minmax(0, 8fr);
}
.imprimiendo .kpis-grilla {
  grid-template-columns: minmax(9rem, 1.1fr) repeat(4, minmax(0, 1fr));
}

/* El que reparte el alto entre las filas y hace que cada panel se acomode adentro del suyo es
   el juego de reglas de `alto-fijo`, que en pantalla pone tablero.js solo si la ventana es
   ancha (en una angosta la pagina scrollea y cada panel mide lo suyo). La hoja mide siempre
   lo mismo, asi que comun.js le pone esa clase al tablero mientras imprime y se la saca al
   terminar: una sola definicion del comportamiento, no dos. Sin eso, exportar desde una
   ventana chica desbordaba la hoja y los paneles se montaban sobre el pie. */

/* En la hoja hay menos alto que en una pantalla, asi que la cromada se achica para que el
   alto se lo lleven los cuadros: el logo un poco mas chico y menos aire en el pie y en el
   cuerpo. Es lo unico que se dibuja distinto de la pantalla, y se gana casi 1cm de cuadros. */
.imprimiendo .logo-imagen { height: 3rem; }
.imprimiendo .cabecera-logo { padding: .35rem 1.1rem; }
.imprimiendo main { padding: .35rem .6rem .4rem; }
.imprimiendo .pie-sitio { padding: .35rem .8rem .4rem; }

/* En pantalla las dos filas parten el alto en partes iguales; en la hoja la de TABLAS se
   lleva algo mas. Una tabla cortada al medio en un PDF no sirve de nada (el ranking tiene que
   salir entero), y un grafico se lee igual en una caja mas baja. Es un REPARTO y no un alto
   libre: con `flex: 0 0 auto` la fila de tablas se quedaba con todo y la de graficos bajaba a
   tres pixeles. El 1,4 sale de medir: es lo que hace entrar las diez posiciones del ranking
   dejando a los graficos una caja todavia comoda. */
.imprimiendo .tablero.con-selector .fila-tablas { flex: 1.4 1 0; min-height: 0; }

/* Los graficos son canvas y en papel saldrian con la resolucion de la pantalla: se imprime
   en su lugar la foto a triple resolucion que cuelga comun.js. `contain` la deja del mismo
   tamaño que tenia el canvas en su caja, sin deformarla. */
.imprimiendo .grafico-en-pantalla { display: none; }
.imprimiendo .grafico-impreso { display: block; width: 100%; height: 100%; object-fit: contain; }
